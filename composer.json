{
    "name": "setono/sylius-video-plugin",
    "description": "Attach videos to Sylius products: uploaded files, external URLs and embed codes, with a Videos tab in the admin and rendering on the product page.",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "video",
        "product",
        "youtube",
        "vimeo",
        "embed"
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/collections": "^1.8 || ^2.0",
        "doctrine/orm": "^2.15 || ^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/composite-compiler-pass": "^1.3",
        "sylius/admin-bundle": "^1.13",
        "sylius/core": "^1.13",
        "sylius/core-bundle": "^1.13",
        "sylius/product-bundle": "^1.13",
        "sylius/resource-bundle": "^1.11",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/form": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/options-resolver": "^6.4",
        "symfony/validator": "^6.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "api-platform/core": "^2.7.16",
        "babdev/pagerfanta-bundle": "^3.8",
        "behat/behat": "^3.14",
        "doctrine/doctrine-bundle": "^2.11",
        "jms/serializer-bundle": "^4.2",
        "lexik/jwt-authentication-bundle": "^2.17",
        "setono/sylius-plugin-pack": "~1.14.5",
        "shipmonk/composer-dependency-analyser": "^1.6",
        "sylius-labs/polyfill-symfony-security": "^1.1.2",
        "symfony/debug-bundle": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/property-info": "^6.4",
        "symfony/serializer": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "symfony/webpack-encore-bundle": "^1.17.2",
        "willdurand/negotiation": "^3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusVideoPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusVideoPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": false
        },
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit",
        "test-e2e": "cd tests/Application && npx playwright test",
        "test-functional": "phpunit --testsuite functional",
        "test-unit": "phpunit --testsuite unit"
    }
}
