<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Setono\SyliusVideoPlugin\EventListener\Doctrine\ProductVideoDiscriminatorMapListener">
            <argument>%sylius.resources%</argument>
            <tag name="doctrine.event_listener" event="loadClassMetadata"/>
        </service>

        <service id="Setono\SyliusVideoPlugin\EventListener\Doctrine\ProductVideoFilesRemovalListener">
            <argument type="service" id="Setono\SyliusVideoPlugin\Uploader\VideoMediaUploaderInterface"/>
            <tag name="doctrine.event_listener" event="onFlush"/>
            <tag name="doctrine.event_listener" event="postFlush"/>
        </service>
    </services>
</container>
