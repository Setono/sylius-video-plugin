<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Setono\SyliusVideoPlugin\EventSubscriber\ProductFormMenuSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Setono\SyliusVideoPlugin\EventSubscriber\VideoFileUploadSubscriber">
            <argument type="service" id="Setono\SyliusVideoPlugin\Uploader\VideoMediaUploaderInterface"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
