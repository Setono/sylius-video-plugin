<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Setono\SyliusVideoPlugin\Form\Type\ProductVideoType">
            <argument type="service" id="Setono\SyliusVideoPlugin\Kind\VideoKindRegistryInterface"/>
            <argument>%setono_sylius_video.model.product_video.class%</argument>
            <tag name="form.type"/>
        </service>

        <service id="Setono\SyliusVideoPlugin\Form\Extension\ProductTypeExtension">
            <tag name="form.type_extension"/>
        </service>

        <!-- Per-kind extensions of ProductVideoType: each contributes one kind's input field(s). -->
        <service id="Setono\SyliusVideoPlugin\Form\Extension\FileProductVideoTypeExtension">
            <tag name="form.type_extension"/>
        </service>
        <service id="Setono\SyliusVideoPlugin\Form\Extension\UrlProductVideoTypeExtension">
            <tag name="form.type_extension"/>
        </service>
        <service id="Setono\SyliusVideoPlugin\Form\Extension\EmbedProductVideoTypeExtension">
            <tag name="form.type_extension"/>
        </service>
    </services>
</container>
