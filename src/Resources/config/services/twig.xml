<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Setono\SyliusVideoPlugin\Twig\VideoTwigExtension">
            <tag name="twig.extension"/>
        </service>

        <!-- Resolved lazily by Twig (twig.runtime) so the extension carries no service deps. -->
        <service id="Setono\SyliusVideoPlugin\Twig\VideoRuntime">
            <argument type="service" id="Setono\SyliusVideoPlugin\Renderer\VideoRendererInterface"/>
            <argument type="service" id="Setono\SyliusVideoPlugin\Poster\VideoPosterResolverInterface"/>
            <argument type="service" id="logger" on-invalid="null"/>
            <tag name="twig.runtime"/>
            <tag name="monolog.logger" channel="setono_sylius_video"/>
        </service>

        <service id="Setono\SyliusVideoPlugin\Twig\MediaUrlRuntime">
            <argument type="service" id="Setono\SyliusVideoPlugin\Filesystem\MediaUrlGeneratorInterface"/>
            <tag name="twig.runtime"/>
        </service>
    </services>
</container>
