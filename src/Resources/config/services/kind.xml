<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!--
            The kinds argument is populated by RegisterVideoKindsPass, which scans the registered
            Sylius resources for models implementing ProductVideoInterface. To add a kind, register
            a subtype resource and ship a ProductVideoType extension for its field(s) — no entry is
            needed here.
        -->
        <service id="Setono\SyliusVideoPlugin\Kind\VideoKindRegistry">
            <argument type="collection"/>
        </service>

        <service id="Setono\SyliusVideoPlugin\Kind\VideoKindRegistryInterface"
                 alias="Setono\SyliusVideoPlugin\Kind\VideoKindRegistry"/>
    </services>
</container>
