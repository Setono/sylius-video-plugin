<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- path is nullable at the DB level because STI rows of other types do not have a file
         path; the application-layer validator enforces a path/file for file videos. -->
    <mapped-superclass name="Setono\SyliusVideoPlugin\Model\FileVideo">
        <field name="path" type="string" length="255" column="path" nullable="true"/>
    </mapped-superclass>

</doctrine-mapping>
