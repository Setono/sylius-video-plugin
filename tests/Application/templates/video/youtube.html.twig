{% set poster = setono_sylius_video_poster(video) %}
<div class="setono-sylius-video setono-sylius-video--youtube">
    <div class="setono-sylius-video__responsive" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;">
        <iframe src="https://www.youtube.com/embed/{{ video_id }}" title="YouTube" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    </div>
</div>
